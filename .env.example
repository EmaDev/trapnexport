# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está en .gitignore: no se versiona.

# ── Push notifications (web-push) ────────────────────────────────────────────
# Generá el par una sola vez por entorno con `npm run vapid` y pegá acá lo que
# imprime. Si regenerás el par, todas las suscripciones existentes dejan de
# aceptar envíos y cada usuario tiene que volver a activar el push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Firebase (cliente) ───────────────────────────────────────────────────────
# Consola de Firebase → Configuración del proyecto → Tus apps → Web.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDxkTG9l6S32DhBJ3tw5lgnvHABNSXtepg
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=prueba-tecnica-2d597.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=prueba-tecnica-2d597
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=prueba-tecnica-2d597.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=206497035437
NEXT_PUBLIC_FIREBASE_APP_ID=1:206497035437:web:293572f393e1997c994224
NEXT_PUBLIC_MEANSUREMENT_ID=G-J6ZFS94KHG
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BLkt2eaUdwYYTn2jG-wOTFANbkUp-UFG5niA7L8tG2kXa4L3Zxfo2xxX_NzV-ijILwIunskdJqemqj6XRWKm4wM
# ============================================================




# ── Firebase Admin (servidor) ────────────────────────────────────────────────
# Consola de Firebase → Cuentas de servicio → Generar nueva clave privada.
# La private key va entre comillas y con los `\n` literales del JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── App ──────────────────────────────────────────────────────────────────────
# URL pública absoluta. La usan `ShareButton`, el `canonical` y OpenGraph: si no
# coincide con el dominio real, los links compartidos apuntan a otro lado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Módulo /admin ────────────────────────────────────────────────────────────
# `true` enciende el guard: el middleware redirige a /admin/login cuando falta
# la cookie de sesión y `requireAdmin()` corta del lado del servidor. Con el
# flag apagado (default) el panel queda abierto — es lo que corresponde
# mientras Firebase Auth no esté conectado, y NO debe salir así a producción.
ADMIN_AUTH_ENABLED=false

# Fecha de lanzamiento que muestra el `CountdownHero` del feed (ISO 8601 con
# offset). Si falta o no parsea, cae al default de src/lib/site.ts.
NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T21:00:00-03:00