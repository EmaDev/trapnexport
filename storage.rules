rules_version = '2';

/*  Reglas de Firebase Storage. Se despliegan con `firebase deploy --only storage`.
 *
 *  Todo lo que se sube acá lo sube **el navegador**, con el SDK del cliente, así
 *  que estas reglas son la validación de verdad y no una segunda barrera detrás
 *  de otra cosa. El servidor sólo borra (`borrarDelBucket` en
 *  `lib/firebase/admin.ts`, con credenciales de servicio, que se saltea todo
 *  esto).
 *
 *  **La escritura pide sesión.** Antes no: las reglas acotaban tamaño y tipo
 *  pero no miraban `request.auth`, con lo cual cualquiera con la configuración
 *  pública del proyecto —que viaja en el bundle, como corresponde— podía llenar
 *  el bucket. El comentario que había asumía que el panel no tenía token porque
 *  se autentica con una cookie de sesión; es cierto que la cookie es lo que
 *  valida el servidor, pero el login del panel pasa por Firebase Auth en el
 *  navegador antes de canjearla, así que el token existe y el claim también.
 *
 *  La lectura sí es pública en todo: son fotos de un feed y de la historia de un
 *  club, y las URLs de descarga ya son links compartibles.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    /** Una imagen razonable: hasta `mb` megas y con tipo de imagen. Acota qué se
     *  puede depositar, para que el bucket no sea un disco gratis. */
    function esImagen(mb) {
      return request.resource.size < mb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de las publicaciones del feed (`lib/storage/post-image.ts`).
    //
    // El `{userId}` del path no es decorativo: es lo que permite exigir que cada
    // quien escriba en su propia carpeta. El uploader ya sube WebP de 80–160 KB;
    // los 3 MB son margen para un caso raro.
    match /trapnexport-post/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSelf(userId) && esImagen(3);
      // El dueño borra lo suyo; el panel borra cualquiera, porque moderar
      // incluye eliminar la publicación de otro con sus fotos.
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Fotos de las conversaciones (`lib/storage/chat-image.ts`).
    //
    // Mismo corte que el feed: cada quien escribe en su propia carpeta y sube
    // WebP comprimido, así que los 3 MB son margen para un caso raro.
    //
    // **La lectura es pública, y en un chat privado eso hay que decirlo.** No
    // es un descuido heredado: es que la imagen la pide el `<img>` del
    // navegador de quien mira la conversación, y una regla que exigiera ser
    // participante necesitaría leer la conversación desde Storage, que no puede.
    // Lo que protege a la foto es el token que Firebase mete en la
    // `downloadURL` —imposible de adivinar—, no un permiso: quien reciba ese
    // link la ve sin estar en el chat. Cerrarlo de verdad es servir las
    // imágenes desde el servidor con URLs firmadas, y es otra decisión.
    //
    // El borrado es sólo del dueño y del panel. No hay pantalla que borre
    // mensajes todavía; lo que sí borra es el compositor, cuando alguien saca
    // una foto que eligió y no llegó a mandar.
    match /trapnexport-chat/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSelf(userId) && esImagen(3);
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Fotos de perfil (`lib/media-upload.ts` → `uploadAvatar`).
    //
    // Se comprimen a 512 px de lado largo, que es todo lo que necesita un avatar
    // de 80 px en pantallas densas.
    match /trapnexport-avatar/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSelf(userId) && esImagen(3);
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Carrete personal del perfil (`lib/media-upload.ts` → `uploadMedia`).
    //
    // Es la única carpeta que acepta video, y por eso es la única con un tope
    // grande: un video no se puede recomprimir en el navegador sin traer un
    // transcoder entero, así que lo único que se puede hacer es acotarlo.
    match /trapnexport-carrete/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSelf(userId)
                            && request.resource.size < 25 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType.matches('video/.*'));
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Imágenes de la historia del club, subidas desde `/admin/historia`
    // (`lib/storage/historia-image.ts`): escudo, fotos de etapas, portadas de
    // temporada, retratos, museo y pósters de clips.
    //
    // No llevan `{userId}`: no son de nadie, son del club. Por eso el corte es
    // el claim `admin` —el mismo que exige `requireAdmin()` del otro lado— y no
    // la identidad del que sube.
    match /trapnexport-historia/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && esImagen(4);
      allow delete: if isAdmin();
    }

    // Nada fuera de las carpetas de arriba. Sin esto, una carpeta nueva escrita
    // por error queda sin regla y Storage la deniega igual — pero explícito se
    // lee mejor que por descarte.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
